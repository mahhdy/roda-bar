<h2>Orders</h2>

<table>
  <tr><th>ID</th><th>Status</th><th>Next</th></tr>

  <% orders.forEach(o => { %>
    <tr>
      <td><%= o._id %></td>
      <td><%= o.status %></td>
      <td>
        <form method="POST" action="/admin/orders/update">
          <input type="hidden" name="id" value="<%= o._id %>">
          <input type="hidden" name="status" value="<%= o.status %>">
          <button>Advance</button>
        </form>
      </td>
    </tr>
  <% }) %>
</table>
